 from pathlib import Path
 from typing import Optional
 
@@ -111,6 +113,55 @@
 }
 
 
+
+def _external_path(manifest_path: Path, value: str) -> Path:
+    path = Path(value).expanduser()
+    return (path if path.is_absolute() else manifest_path.parent / path).resolve()
+
+
+def _load_external_training_views() -> None:
+    manifest_value = os.environ.get("IOT_EVENT_DATASET_MANIFEST")
+    if not manifest_value:
+        return
+    manifest_path = Path(manifest_value).expanduser().resolve(strict=True)
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if manifest.get("schema_version") != "iot_exp_training_views_manifest_v1":
+        raise ValueError("unsupported external training-view manifest")
+    session_id = manifest["session_id"]
+    for view in manifest["event_views"]:
+        name = f"lx04_{view['name']}_{session_id}"
+        if name in DATASETS:
+            raise ValueError(f"duplicate dataset name: {name}")
+        processed_dir = _external_path(manifest_path, view["processed_dir"])
+        pcap = _external_path(manifest_path, view["source_pcapng_path"])
+        positive = _external_path(manifest_path, view["positive_bags_path"])
+        unlabeled = _external_path(manifest_path, view["unlabeled_bags_path"])
+        valid = _external_path(manifest_path, view["valid_bags_path"])
+        for required in (pcap, positive, unlabeled, valid):
+            if not required.is_file():
+                raise FileNotFoundError(f"external dataset input missing: {required}")
+        config = _build_config(
+            name,
+            processed_dir,
+            pcap,
+            processed_dir / "not_used_aligned_events.csv",
+            manifest_path.parent / "event_decisions.jsonl",
+            "not_used_prebuilt_bags",
+            name,
+            view["event_type"],
+            device_ip=view["device_ip"],
+        )
+        DATASETS[name] = replace(
+            config,
+            positive_bags=positive,
+            unlabeled_bags=unlabeled,
+            valid_bags=valid,
+        )
+
+
+_load_external_training_views()
+
+
 def get_dataset(name: str = "light") -> DatasetConfig:
